rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.role == 'admin';
    }

    // 1. Photos et dossiers de profils utilisateurs
    match /profiles/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if (isOwner(userId) || isAdmin())
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /profile_photos/{userId}.jpg {
      allow read: if isAuthenticated();
      allow write: if (isOwner(userId) || isAdmin())
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(userId) || isAdmin();
    }

    // 2. Vidéos et miniatures publiées
    match /videos/{userId}/{videoId}/{fileName} {
      allow read: if isAuthenticated();
      // Vidéos jusqu'à 100 Mo, Miniatures images jusqu'à 5 Mo
      allow write: if (isOwner(userId) || isAdmin()) && (
        (request.resource.contentType.matches('video/.*') && request.resource.size < 100 * 1024 * 1024) ||
        (request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024)
      );
      allow delete: if isOwner(userId) || isAdmin();
    }
  }
}
